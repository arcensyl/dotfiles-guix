# This script automatically generates a 'hardware.scm' file for HOST.

# Be warned, this script currently makes a lot of assumption about the partitions on this system.
# It will fail if there isn't a root, EFI boot, and swap partition.
# It will also fail if the types of the root and boot partitions aren't what it expects.

host="$1"

if [ -z "$host" ]; then
    echo "Host not specified" >&2
    exit 1
fi

config_file=~/.dotfiles/guix/hosts/"$host"/hardware.scm

root_device="$(findmnt -n -o SOURCE /)"
root_fstype="$(findmnt -n -o FSTYPE /)"

if [ -z "$root_device" ]; then
    echo "Root partition not found" >&2
    exit 2
fi

if [ "$root_fstype" != "ext4" ]; then
    echo "Root partition is not of type EXT4" >&2
    exit 2
fi

root_uuid="$(udevadm info --query=property --name "$root_device" | awk -F= '/^ID_FS_UUID=/ {print $2}')"

boot_device="$(findmnt -n -o SOURCE /boot/efi)"
boot_fstype="$(findmnt -n -o FSTYPE /boot/efi)"

if [ -z "$boot_device" ]; then
    echo "EFI boot partition not found" >&2
    exit 2
fi

if [ "$boot_fstype" != "vfat" ]; then
    echo "EFI boot partition is not of type VFAT" >&2
    exit 2
fi

boot_uuid="$(udevadm info --query=property --name "$boot_device" | awk -F= '/^ID_FS_UUID=/ {print $2}')"

swap_device="$(swapon --show | awk 'NR>1 {print $1}')"

# TODO: Ensure this actually detects when there's no swap partition.
if [ -z "$swap_device" ]; then
    echo "Swap partition not found" >&2
    exit 2
fi

swap_uuid="$(udevadm info --query=property --name "$swap_device" | awk -F= '/^ID_FS_UUID=/ {print $2}')"

cat > "$config_file" <<EOF
;; This file was automatically generated.
;; Do NOT edit this file yourself.

(use-modules (gnu)
             (my core))

(use-swap-space
  (swap-space
    (target (uuid "${swap_uuid}"))))

(use-file-system
  (file-system
    (device (uuid "${boot_uuid}"
                  'fat32))
    (mount-point "/boot/efi")
    (type "${boot_fstype}")))

(use-file-system
  (file-system
    (device (uuid "${root_uuid}"
                  'ext4))
    (mount-point "/")
    (type "${root_fstype}")))
EOF
